# Copie para .env (na raiz para testar localmente, ou em servidor/ no servidor interno).
# O .env nunca vai para o Git.

# Banco de dados (escolha senhas fortes; não mude depois que o banco for criado)
DB_PASS=
DB_ROOT_PASS=

# Gere com: docker run --rm node:22.12.0-alpine node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=6h

# Usuário "admin" (primeiro acesso) e observador sem cadastro (vazio = desligado)
SENHA_ADMIN=
SENHA_LEITURA=

# IA: basta uma das chaves; com as duas, uma é reserva da outra
GEMINI_API_KEY=
GEMINI_MODELO=
GROQ_API_KEY=
GROQ_MODELO=
# "groq" para usar o Groq primeiro
IA_PRINCIPAL=

# Porta exposta (local: 8088; servidor: a do gateway, 80)
PORTA=
