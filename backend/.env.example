PORT=3333

DB_HOST=localhost
DB_PORT=3306
DB_NAME=reunioes
DB_USER=reunioes
DB_PASS=troque-esta-senha

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=6h

# Usuário "admin" (primeiro acesso) e observador sem cadastro (vazio = desligado)
SENHA_ADMIN=
SENHA_LEITURA=

# IA: o administrador cadastra as chaves na tela (Metadados IA). As daqui só valem
# se não houver chave cadastrada na tela. Basta uma; com as duas, uma é reserva da outra.
GEMINI_API_KEY=
GEMINI_MODELO=
GROQ_API_KEY=
GROQ_MODELO=
# "groq" para usar o Groq primeiro
IA_PRINCIPAL=
